# macOS
.DS_Store

# Editors
*.swp
*.swo
*~
.vscode/
.idea/

# Claude Code local settings
.claude/settings.local.json

# Cursor local config (not committed — each user configures locally)
.cursor/

# Archived source material (research, old prompts, chat artifacts)
.archive/

# Orchestrator lock runtime state (created on acquire; never committed)
.workspace-lock/

# The pinned github MCP server binary (downloaded by hand, see tools/github-mcp/README.md)
tools/github-mcp/bin/

# Local environment files (may hold secrets; never committed)
.env
.env.*

# Keys and credentials (never committed)
*.pem
*.key
*.p12
*.jks
credentials.*
